{
  "name": "assistant-dsi-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project for TikTok videos (1080x1920, 60fps, H.264)",
  "scripts": {
    "dev": "remotion studio",
    "build": "npm run build:list-comprehension && npm run build:linear-regression",
    "build:list-comprehension": "remotion render ListComprehension out/list-comprehension.mp4",
    "build:linear-regression": "remotion render LinearRegression out/linear-regression.mp4",
    "upgrade": "remotion upgrade",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.541",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
